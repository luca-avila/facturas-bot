# Local Postgres from `docker compose up -d db`
DATABASE_URL=postgresql://facturas:facturas@localhost:5432/facturas

# Signs session cookies. At least 32 characters: generate one with
# `openssl rand -base64 48`. Changing it signs everyone out.
JWT_SECRET=

# Absolute path where uploaded photos are stored, outside the repo, such as
# /home/you/facturas-uploads. The backend creates it.
UPLOAD_DIR=

# Claude API key for the extraction worker. Only the worker reads it.
ANTHROPIC_API_KEY=
# Extraction model, decision 8 in system-design.md.
LLM_MODEL=claude-haiku-5-5
# The restaurant's own CUIT, 11 digits. It never resolves a supplier.
RESTAURANT_CUIT=
