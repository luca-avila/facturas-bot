// Models arrive with the slices that use them. See system-design.md for the data model.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff

  @@map("user_role")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  name          String
  passwordHash  String    @map("password_hash")
  passwordSetAt DateTime  @map("password_set_at") @db.Timestamptz(6)
  role          UserRole
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  documentsCreated  Document[] @relation("DocumentCreatedBy")
  documentsReviewed Document[] @relation("DocumentReviewedBy")
  auditEntries      AuditLog[]
  paymentsCreated   Payment[]

  @@map("users")
}

enum DocumentType {
  invoice
  delivery_note
  credit_note
  opening_balance

  @@map("document_type")
}

enum DocumentSource {
  upload
  manual

  @@map("document_source")
}

enum ReviewStatus {
  processing
  error
  unreviewed
  reviewed

  @@map("review_status")
}

enum DueDateSource {
  supplier_term
  manual

  @@map("due_date_source")
}

model Supplier {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  legalName       String?    @map("legal_name")
  cuit            String?    @unique @db.Char(11)
  paymentTermDays Int?       @map("payment_term_days")
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents       Document[]
  payments        Payment[]

  @@map("suppliers")
}

model Document {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             DocumentType?
  source           DocumentSource
  reviewStatus     ReviewStatus   @map("review_status")
  supplierId       String?        @map("supplier_id") @db.Uuid
  supplier         Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  letter           String?
  number           String?
  numberNormalized String?        @map("number_normalized")
  issueDate        DateTime?      @map("issue_date") @db.Date
  dueDate          DateTime?      @map("due_date") @db.Date
  dueDateSource    DueDateSource? @map("due_date_source")
  subtotal         Decimal?       @db.Decimal(14, 2)
  total            Decimal?       @db.Decimal(14, 2)
  cae              String?
  /// Open validation issues, as [{ "code": "…" }], in the order of ISSUE_CODES.
  issues           Json           @default("[]")
  notes            String?
  createdById      String         @map("created_by") @db.Uuid
  createdBy        User           @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewedById     String?        @map("reviewed_by") @db.Uuid
  reviewedBy       User?          @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicationsReceived Application[]   @relation("ApplicationDocument")
  applicationsGiven    Application[]   @relation("ApplicationCreditNote")
  images               DocumentImage[]
  extractionJobs       ExtractionJob[]
  lines                DocumentLine[]
  taxes                DocumentTax[]

  @@map("documents")
}

/**
 * Rows never change: no updated_at. The file at storage_key is written once
 * and never changed (E5).
 */
model DocumentImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  position   Int
  storageKey String   @unique @map("storage_key")
  mimeType   String   @map("mime_type")
  width      Int
  height     Int
  sizeBytes  Int      @map("size_bytes")
  sha256     String   @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([documentId, position])
  @@index([sha256])
  @@map("document_images")
}

enum ExtractionJobStatus {
  queued
  running
  succeeded
  failed

  @@map("extraction_job_status")
}

model ExtractionJob {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId    String              @map("document_id") @db.Uuid
  document      Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  status        ExtractionJobStatus
  attempts      Int
  runAfter      DateTime            @map("run_after") @db.Timestamptz(6)
  /// Set while running: the lease. Null otherwise.
  lockedUntil   DateTime?           @map("locked_until") @db.Timestamptz(6)
  model         String?
  promptVersion String?             @map("prompt_version")
  /// The model's JSON, written once (E3).
  rawOutput     Json?               @map("raw_output")
  lastError     String?             @map("last_error")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([documentId])
  @@map("extraction_jobs")
}

/// Rows never change: a run replaces all of a document's lines.
model DocumentLine {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  document    Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  position    Int
  productCode String?  @map("product_code")
  description String
  quantity    Decimal? @db.Decimal(14, 3)
  unit        String?
  packageText String?  @map("package_text")
  unitPrice   Decimal? @map("unit_price") @db.Decimal(16, 4)
  ivaRate     Decimal? @map("iva_rate") @db.Decimal(5, 2)
  discountPct Decimal? @map("discount_pct") @db.Decimal(5, 2)
  lineTotal   Decimal? @map("line_total") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([documentId, position])
  @@map("document_lines")
}

enum TaxKind {
  iva
  iva_perception
  iibb_perception
  other

  @@map("tax_kind")
}

/// Rows never change: a run replaces all of a document's taxes.
model DocumentTax {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  kind       TaxKind
  label      String
  rate       Decimal? @db.Decimal(5, 2)
  base       Decimal? @db.Decimal(14, 2)
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([documentId])
  @@map("document_taxes")
}

enum PaymentMethod {
  transfer
  echeq
  cash
  mercado_pago
  other

  @@map("payment_method")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId        String        @map("supplier_id") @db.Uuid
  supplier          Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount            Decimal       @db.Decimal(14, 2)
  paidOn            DateTime      @map("paid_on") @db.Date
  valueDate         DateTime?     @map("value_date") @db.Date
  method            PaymentMethod
  reference         String?
  notes             String?
  createdById       String        @map("created_by") @db.Uuid
  createdBy         User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicationsGiven Application[]

  @@index([supplierId])
  @@map("payments")
}

/**
 * Rows never change: no updated_at or deleted_at.
 */
model Application {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  document     Document  @relation("ApplicationDocument", fields: [documentId], references: [id], onDelete: Restrict)
  paymentId    String?   @map("payment_id") @db.Uuid
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creditNoteId String?   @map("credit_note_id") @db.Uuid
  creditNote   Document? @relation("ApplicationCreditNote", fields: [creditNoteId], references: [id], onDelete: Restrict)
  amount       Decimal   @db.Decimal(14, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([documentId])
  @@index([paymentId])
  @@index([creditNoteId])
  @@map("applications")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_log")
}
