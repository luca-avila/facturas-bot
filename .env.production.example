# Production environment template. Copy to `.env.production` on the VPS
# (`chmod 600 .env.production`) and fill in every value. Never commit `.env.production`.

# Public hostname pointed at the VPS (A/AAAA DNS record), no scheme or path.
APP_DOMAIN=facturas.example.com

# Email address for Let's Encrypt expiry/renewal notices.
CERTBOT_EMAIL=admin@example.com

# PostgreSQL credentials. Generate POSTGRES_PASSWORD with `openssl rand -hex 24`
# (URL-safe characters only, since docker-compose.prod.yml embeds it in DATABASE_URL).
POSTGRES_USER=facturas
POSTGRES_PASSWORD=
POSTGRES_DB=facturas

# Signs session cookies. At least 32 characters: generate with `openssl rand -base64 48`.
# Changing it signs every user out. Only the backend container reads this.
JWT_SECRET=

# Claude API key for the extraction worker. Only the worker container reads this.
ANTHROPIC_API_KEY=

# Extraction model, decision 8 in system-design.md. Only the worker container reads this.
LLM_MODEL=claude-haiku-5-5

# The restaurant's own CUIT, 11 digits with no hyphens and a valid check digit.
# Never resolves a supplier; flags documents addressed to another CUIT. Only the worker reads this.
RESTAURANT_CUIT=
